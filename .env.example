# Copy this file to ~/.secret/island-utility/daily-screenshot.env and fill in
# your values. Read by the local utility scripts at startup. The service-account
# key JSON (daily-screenshot-443720-*.json) lives in the same directory.

# The pre-2026-27 weather_scans folder. Used by verify_latest_drive.py
# without --location, and by download_drive_screenshots.py.
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id-here

# Per-location folders under Weather Scans. Used by thum.py and by
# verify_latest_drive.py --location <slug>.
GOOGLE_DRIVE_FOLDER_ID_DUNCAN=your-duncan-folder-id-here
GOOGLE_DRIVE_FOLDER_ID_LAKE_COWICHAN=your-lake-cowichan-folder-id-here

# Needed only by diagnose_cache.py (live thum.io capture).
# Use the same value that's set on Render.
THUM_AUTH=your-thum-io-auth-key-here
